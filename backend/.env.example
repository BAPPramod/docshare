# Copy this to .env and fill the values

# Database connection (PostgreSQL / Neon)
# Local: set DATABASE_URL and DIRECT_URL to the same connection string.
# Neon: DATABASE_URL = pooled (-pooler host), DIRECT_URL = direct (non-pooler host).
# Include ?sslmode=require on Neon URLs (from the Neon dashboard).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret key for JWT signing (replace with a secure random string in real apps)
JWT_SECRET="your-secret-here"

# Port for backend server
PORT=3000

# Optional
# NODE_ENV=development
